      "familyName": "Schmidt",
      "orcid": "https://orcid.org/0000-0003-4696-2101",
      "affiliation": {
        "type": [
          "Organization"
        ],
        "name": "Freie Universität Berlin"
      }
    }
  ],
  "publisher": {
    "type": [
      "Organization"
    ],
    "name": "Research Squirrel Engineers Network"
  },
  "issued": "2026-04-27",
  "modified": "2026-08-19",
  "version": "0.11.0",
  "resourceType": "http://purl.org/dc/dcmitype/Dataset",
  "accessRights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC",
  "landingPage": "https://research-squirrel-engineers.github.io/bb-5kbc-sites/",
  "keywords": [
    "Archaeology",
    "Neolithic",
    "Brandenburg",
    "Linked Open Data",
    "CIDOC CRM",
    "SHACL"
  ],
  "language": [
    "http://id.loc.gov/vocabulary/iso639-1/de",
    "http://id.loc.gov/vocabulary/iso639-1/en"
  ],
  "conformsTo": [
    "https://w3id.org/nfdi4objects/profile/v0.1",
    "http://data.europa.eu/r5r/"
  ],
  "distributions": [
    {
      "role": "bundle",
      "title": {
        "en": "RDF bundle (data and ontology)",
        "de": "RDF-Bundle (Daten und Ontologie)"
      },
      "file": "rdf/bb5kbc-bundle.ttl",
      "source": "https://raw.githubusercontent.com/Research-Squirrel-Engineers/bb-5kbc-sites/main/dist/bb5kbc-bundle.ttl",
      "accessURL": "https://github.com/Research-Squirrel-Engineers/bb-5kbc-sites/",
      "downloadURL": "https://raw.githubusercontent.com/Research-Squirrel-Engineers/bb-5kbc-sites/main/dist/bb5kbc-bundle.ttl",
      "mediaType": "https://www.iana.org/assignments/media-types/text/turtle"
    }
  ],
  "model": {
    "bundle": "rdf/bb5kbc-bundle.ttl"
  },
  "map": {
    "title": {
      "en": "Where the sites are",
      "de": "Wo die Fundstellen liegen"
    },
    "intro": {
      "en": "All 540 sites, with their cultural attribution and the confidence of their location. The four confidence levels come from the FSL vocabulary: Q23 direct from the database, Q15 locatable to a district, Q24 only to a municipality centroid, Q113 a coordinate error.",
      "de": "Alle 540 Fundstellen mit kultureller Zuordnung und Verortungsguete."
    },
    "colour_column": "culture",
    "sparql": "SELECT ?label ?culture ?confidence ?wkt WHERE {\n  ?site a bb5kbc:Fundstelle ; rdfs:label ?label ;\n        geo:hasGeometry/geo:asWKT ?wkt ;\n        fsl:certaintyLevel ?cl ;\n        bb5kbc:hatKulturelleZuordnung/bb5kbc:hatKulturgruppe/rdfs:label ?culture .\n  BIND(REPLACE(STR(?cl), \"^.*/\", \"\") AS ?confidence)\n}\n"
  },
  "prefixes": "PREFIX bb5kbc: <http://w3id.org/bb5kbc/ont/>\nPREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>\nPREFIX fsl: <http://fuzzy-sl.squirrel.link/ontology/>\nPREFIX geo: <http://www.opengis.net/ont/geosparql#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n",
  "queries": [
    {
      "id": "sites-on-a-map",
      "view": "map",
      "view_columns": {
        "label": "label",
        "colour": "culture"
      },
      "title": {
        "en": "The sites, on a map",
        "de": "Die Fundstellen auf der Karte"
      },
      "intro": {
        "en": "Every site with its cultural attribution. Any result carrying a coordinate is drawn on a map above the table, whatever else the query asks for — so an edit that adds a filter narrows the map with it.",
        "de": "Jede Fundstelle mit ihrer kulturellen Zuordnung, als Karte ueber der Tabelle."
      },
      "sparql": "SELECT ?label ?culture ?wkt WHERE {\n  ?site a bb5kbc:Fundstelle ; rdfs:label ?label ;\n        geo:hasGeometry/geo:asWKT ?wkt ;\n        bb5kbc:hatKulturelleZuordnung/bb5kbc:hatKulturgruppe/rdfs:label ?culture .\n} ORDER BY ?culture ?label\n"
    },
    {
      "id": "culture-chronology",
      "view": "intervals",
      "view_columns": {
        "from": "from",
        "to": "to",
        "label": "culture"
      },
      "title": {
        "en": "The cultural groups on a time axis",
        "de": "Die Kulturgruppen auf der Zeitachse"
      },
      "intro": {
        "en": "Where each cultural group sits in time, and how many sites carry it. The Mesolithic bar spans four thousand years and dwarfs everything else: that is the record, not a drawing error. Add FILTER(?st >= -5500) to see the Neolithic groups at a readable scale.",
        "de": "Wo jede Kulturgruppe zeitlich liegt und wie viele Fundstellen sie traegt. Der Mesolithikum-Balken umspannt vier Jahrtausende."
      },
      "sparql": "SELECT ?culture (MIN(?st) AS ?from) (MAX(?en) AS ?to)\n       (COUNT(DISTINCT ?site) AS ?sites) WHERE {\n  ?site bb5kbc:hatKulturelleZuordnung ?kz .\n  ?kz bb5kbc:hatKulturgruppe/rdfs:label ?culture ;\n      bb5kbc:hatDatierung ?d .\n  ?d bb5kbc:datierungStart ?st ; bb5kbc:datierungEnd ?en .\n} GROUP BY ?culture ORDER BY ?from\n"
    },
    {
      "id": "time-slice",
      "view": "map",
      "view_columns": {
        "label": "label",
        "colour": "culture"
      },
      "title": {
        "en": "What existed around 4500 BC",
        "de": "Was um 4500 v. Chr. bestand"
      },
      "intro": {
        "en": "Sites whose dating interval contains the year in the filter. This is the query to play with: change -4500 and press Run again, and the settlement pattern moves. The scale runs from about -5000 to -3900 for the Neolithic groups.",
        "de": "Fundstellen, deren Datierungsintervall das Jahr im Filter enthaelt. Zahl aendern, Run druecken, und das Siedlungsbild wandert."
      },
      "sparql": "SELECT ?label ?culture ?wkt WHERE {\n  ?site rdfs:label ?label ;\n        geo:hasGeometry/geo:asWKT ?wkt ;\n        bb5kbc:hatKulturelleZuordnung ?kz .\n  ?kz bb5kbc:hatKulturgruppe/rdfs:label ?culture ;\n      bb5kbc:hatDatierung ?d .\n  ?d bb5kbc:datierungStart ?st ; bb5kbc:datierungEnd ?en .\n  FILTER(?st <= -4500 && ?en >= -4500)\n} ORDER BY ?culture ?label\n"
    },
    {
      "id": "discovery-and-type",
      "view": "barchart",
      "view_columns": {
        "category": "mode",
        "value": "sites"
      },
      "title": {
        "en": "How the sites were found",
        "de": "Wie die Fundstellen entdeckt wurden"
      },
      "intro": {
        "en": "The site type is known almost only where somebody excavated: stray finds and surface collections account for most of the record and leave the type unknown. That is a fact about research history rather than about prehistory, and it belongs beside every distribution map here. Group by ?type as well to see the cross-tabulation.",
        "de": "Der Fundstellentyp ist fast nur dort bekannt, wo gegraben wurde — eine Aussage ueber die Forschungsgeschichte, nicht ueber die Vorgeschichte."
      },
      "sparql": "SELECT ?mode (COUNT(DISTINCT ?site) AS ?sites) WHERE {\n  ?site bb5kbc:wurdeEntdecktDurch/bb5kbc:hatEntdeckungsart/rdfs:label ?mode .\n} GROUP BY ?mode ORDER BY DESC(?sites)\n"
    },
    {
      "id": "dating-precision",
      "view": "scatter",
      "view_columns": {
        "x": "sites",
        "y": "widest",
        "label": "culture"
      },
      "title": {
        "en": "How sharply each group is dated",
        "de": "Wie scharf jede Gruppe datiert ist"
      },
      "intro": {
        "en": "The width of the dating interval, per cultural group, against the number of sites. A group in the lower right is both well represented and tightly dated; one at the top is carried by an interval so wide that little follows from it.",
        "de": "Breite des Datierungsintervalls je Kulturgruppe gegen die Anzahl der Fundstellen."
      },
      "sparql": "SELECT ?culture (COUNT(DISTINCT ?site) AS ?sites)\n       (MIN(?span) AS ?tightest) (MAX(?span) AS ?widest) WHERE {\n  ?site bb5kbc:hatKulturelleZuordnung ?kz .\n  ?kz bb5kbc:hatKulturgruppe/rdfs:label ?culture ;\n      bb5kbc:hatDatierung ?d .\n  ?d bb5kbc:datierungStart ?st ; bb5kbc:datierungEnd ?en .\n  BIND(?en - ?st AS ?span)\n} GROUP BY ?culture ORDER BY ?widest\n"
    },
    {
      "id": "locational-confidence",
      "view": "map",
      "view_columns": {
        "label": "label",
        "colour": "confidence"
      },
      "title": {
        "en": "How well each site is located",
        "de": "Wie gut jede Fundstelle verortet ist"
      },
      "intro": {
        "en": "The same points as the first map, coloured by the FSL confidence item instead of by culture: Q23 taken directly from the database, Q15 locatable to a district, Q24 only to a municipality centroid. A cluster of Q24 is a cluster of centroids, not a cluster of settlement.",
        "de": "Dieselben Punkte, gefaerbt nach FSL-Verortungsguete statt nach Kultur. Eine Haeufung von Q24 ist eine Haeufung von Mittelpunkten."
      },
      "sparql": "SELECT ?label ?confidence ?accuracy ?wkt WHERE {\n  ?site a bb5kbc:Fundstelle ; rdfs:label ?label ;\n        geo:hasGeometry/geo:asWKT ?wkt ;\n        fsl:certaintyLevel ?cl ;\n        bb5kbc:hatGenauigkeit ?accuracy .\n  BIND(REPLACE(STR(?cl), \"^.*/\", \"\") AS ?confidence)\n} ORDER BY ?confidence\n"
    },
    {
      "id": "uncertain-attributions",
      "view": "map",
      "view_columns": {
        "label": "label",
        "colour": "type"
      },
      "title": {
        "en": "Where the record hedges",
        "de": "Wo die Quellen zoegern"
      },
      "intro": {
        "en": "Values the source marked with a question mark are not quietly cleaned up in this dataset: they carry fsl:certaintyDesc \"uncertain\". These are the site types the excavator would not commit to.",
        "de": "Mit Fragezeichen markierte Werte werden nicht stillschweigend bereinigt, sondern tragen fsl:certaintyDesc \"uncertain\"."
      },
      "sparql": "SELECT ?label ?type ?wkt WHERE {\n  ?site bb5kbc:hatFundstellenart ?t ; rdfs:label ?label ;\n        geo:hasGeometry/geo:asWKT ?wkt .\n  ?t fsl:certaintyDesc \"uncertain\"@en ; rdfs:label ?type .\n} ORDER BY ?label\n"
    },
    {
      "id": "literature-coverage",
      "view": "barchart",
      "view_columns": {
        "category": "kreis",
        "value": "sites"
      },
      "title": {
        "en": "Sites per district, and how many are published",
        "de": "Fundstellen je Kreis, und wie viele publiziert sind"
      },
      "intro": {
        "en": "Where the corpus is dense and where the literature is thin. A district with many sites and few publications is not necessarily under-researched — it may be that its excavations are reported in a form the source database does not cite.",
        "de": "Wo der Bestand dicht ist und wo die Literatur duenn wird."
      },
      "sparql": "SELECT ?kreis (COUNT(DISTINCT ?site) AS ?sites)\n       (COUNT(DISTINCT ?pub) AS ?published) WHERE {\n  ?site a bb5kbc:Fundstelle ;\n        bb5kbc:inGemeinde/bb5kbc:inKreis/rdfs:label ?kreis .\n  OPTIONAL { ?site bb5kbc:hatPublikation ?p BIND(?site AS ?pub) }\n} GROUP BY ?kreis ORDER BY DESC(?sites)\n"
    },
    {
      "id": "georeferencing-source",
      "view": "barchart",
      "view_columns": {
        "category": "source",
        "value": "sites"
      },
      "title": {
        "en": "Where the coordinates came from",
        "de": "Woher die Koordinaten stammen"
      },
      "intro": {
        "en": "Every coordinate in this dataset was assigned by a georeferencing activity that records its own source. Provenance of the geometry, not of the site.",
        "de": "Jede Koordinate stammt aus einer Georeferenzierungs-Aktivitaet, die ihre Quelle mitfuehrt."
      },
      "sparql": "SELECT ?source (COUNT(DISTINCT ?site) AS ?sites) WHERE {\n  ?site bb5kbc:wurdeGeoreferenziertDurch ?a .\n  ?a fsl:hasSourceType/rdfs:label ?source .\n} GROUP BY ?source ORDER BY DESC(?sites)\n"
    },
    {
      "id": "cross-border",
      "view": "barchart",
      "view_columns": {
        "category": "culture",
        "value": "sites"
      },
      "title": {
        "en": "German and Polish sites per cultural group",
        "de": "Deutsche und polnische Fundstellen je Kulturgruppe"
      },
      "intro": {
        "en": "The dataset straddles a modern border that means nothing to the fifth millennium BC. Grouping by country and culture shows which groups the border cuts through and which sit wholly on one side — a property of research traditions and of the source databases as much as of prehistory.",
        "de": "Der Datensatz ueberschreitet eine moderne Grenze, die dem 5. Jahrtausend v. Chr. nichts bedeutet."
      },
      "sparql": "SELECT ?culture ?land (COUNT(DISTINCT ?site) AS ?sites) WHERE {\n  ?site bb5kbc:inGemeinde/bb5kbc:inKreis/bb5kbc:inBundesland/bb5kbc:inLand/rdfs:label ?land ;\n        bb5kbc:hatKulturelleZuordnung/bb5kbc:hatKulturgruppe/rdfs:label ?culture .\n} GROUP BY ?culture ?land ORDER BY DESC(?sites)\n"
    },
    {
      "id": "classes-with-counts",
      "title": {
        "en": "Classes used, with counts",
        "de": "Verwendete Klassen mit Anzahl"
      },
      "intro": {
        "en": "What this collection actually contains — the counterpart to the void:classPartition statistics in the metadata. If the two disagree, the metadata is stale.",
        "de": "Was die Sammlung tatsaechlich enthaelt — die Gegenprobe zur void:classPartition-Statistik."
      },
      "sparql": "SELECT ?class (COUNT(?s) AS ?count) WHERE {\n  ?s a ?class\n} GROUP BY ?class ORDER BY DESC(?count)\n"
    },
    {
      "id": "sites-via-crm",
      "title": {
        "en": "Sites via their CIDOC CRM superclass",
        "de": "Fundstellen ueber die CIDOC-CRM-Oberklasse"
      },
      "intro": {
        "en": "Checks that the alignment holds: the query asks for crm:E27_Site and is answered from bb5kbc:Fundstelle. This is what lets the collection be queried alongside other N4O collections that never heard of this ontology.",
        "de": "Prueft, ob die Ausrichtung haelt: gefragt wird nach crm:E27_Site, geantwortet aus bb5kbc:Fundstelle."
      },
      "sparql": "SELECT (COUNT(DISTINCT ?site) AS ?sites) WHERE {\n  ?site a/rdfs:subClassOf* crm:E27_Site\n}"
    }
  ]
}
