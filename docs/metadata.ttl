                "RDF bundle (data and ontology)"@en ;
            dct:type n4op:roleBundle ;
            dcat:accessURL <https://github.com/Research-Squirrel-Engineers/bb-5kbc-sites/> ;
            dcat:downloadURL <https://raw.githubusercontent.com/Research-Squirrel-Engineers/bb-5kbc-sites/main/dist/bb5kbc-bundle.ttl> ;
            dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ] ;
    dcat:keyword "Archaeology",
        "Brandenburg",
        "CIDOC CRM",
        "Linked Open Data",
        "Neolithic",
        "SHACL" ;
