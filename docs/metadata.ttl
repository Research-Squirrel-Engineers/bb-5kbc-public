<file:///home/claude/buildtree/bb-5kbc-public/classes-with-counts> a sh:SPARQLSelectExecutable ;
    dct:title "Verwendete Klassen mit Anzahl"@de,
        "Classes used, with counts"@en ;
    rdfs:comment "Was diese Sammlung tatsaechlich enthaelt — die Gegenprobe zur void:classPartition-Statistik in den Metadaten."@de,
        "What this collection actually contains. The counterpart to the void:classPartition statistics in the metadata: if the two disagree, the metadata is stale."@en ;
    sh:select """PREFIX bb5kbc: <http://w3id.org/bb5kbc/ont/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?class (COUNT(?s) AS ?count) WHERE {
  ?s a ?class
} GROUP BY ?class ORDER BY DESC(?count)
""" .

<file:///home/claude/buildtree/bb-5kbc-public/sites> a sh:SPARQLSelectExecutable ;
    dct:title "Fundstellen mit Bezeichnung"@de,
        "Sites with their labels"@en ;
    rdfs:comment "Die Fundstellen selbst, das Rueckgrat des Datensatzes."@de,
        "The archaeological sites themselves, the backbone of the dataset."@en ;
    sh:select """PREFIX bb5kbc: <http://w3id.org/bb5kbc/ont/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?site ?label WHERE {
  ?site a bb5kbc:Fundstelle ;
        rdfs:label ?label
} ORDER BY ?label LIMIT 50
""" .

<file:///home/claude/buildtree/bb-5kbc-public/sites-via-crm> a sh:SPARQLSelectExecutable ;
    dct:title "Fundstellen ueber die CIDOC-CRM-Oberklasse"@de,
        "Sites via their CIDOC CRM superclass"@en ;
    rdfs:comment "Prueft, ob die Ausrichtung greift: gefragt wird nach crm:E27_Site, geantwortet wird aus bb5kbc:Fundstelle."@de,
        "Checks that the alignment works: the query asks for crm:E27_Site and is answered from bb5kbc:Fundstelle. This is what makes the collection queryable alongside other N4O collections that never heard of this ontology."@en ;
    sh:select """PREFIX bb5kbc: <http://w3id.org/bb5kbc/ont/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT (COUNT(DISTINCT ?site) AS ?sites) WHERE {
  ?site a/rdfs:subClassOf* crm:E27_Site
}
""" .

<http://w3id.org/bb5kbc/ont/Entdeckung> rdfs:subClassOf crm:E5_Event .

<http://w3id.org/bb5kbc/ont/Fundstelle> rdfs:subClassOf crm:E27_Site .

<http://w3id.org/bb5kbc/ont/GeoreferenzierungsAktivitaet> rdfs:subClassOf crm:E13_Attribute_Assignment .

<https://raw.githubusercontent.com/Research-Squirrel-Engineers/bb-5kbc-sites/main/dist/bb5kbc-bundle.ttl> spdx:checksum [ spdx:algorithm spdx:checksumAlgorithm_sha256 ;
