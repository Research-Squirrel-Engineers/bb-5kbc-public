  "distributions": [
    {
      "role": "bundle",
      "title": {
        "en": "RDF bundle (data and ontology)",
        "de": "RDF-Bundle (Daten und Ontologie)"
      },
      "file": "rdf/bb5kbc-bundle.ttl",
      "source": "https://raw.githubusercontent.com/Research-Squirrel-Engineers/bb-5kbc-sites/main/dist/bb5kbc-bundle.ttl",
      "accessURL": "https://github.com/Research-Squirrel-Engineers/bb-5kbc-sites/",
      "downloadURL": "https://raw.githubusercontent.com/Research-Squirrel-Engineers/bb-5kbc-sites/main/dist/bb5kbc-bundle.ttl",
      "mediaType": "https://www.iana.org/assignments/media-types/text/turtle"
    }
  ],
  "model": {
    "bundle": "rdf/bb5kbc-bundle.ttl",
    "classes": [
      {
        "class": "http://w3id.org/bb5kbc/ont/Fundstelle",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E27_Site"
      },
      {
        "class": "http://w3id.org/bb5kbc/ont/Entdeckung",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E5_Event"
      },
      {
        "class": "http://w3id.org/bb5kbc/ont/GeoreferenzierungsAktivitaet",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E13_Attribute_Assignment"
      }
    ],
    "properties": []
  },
  "prefixes": "PREFIX bb5kbc: <http://w3id.org/bb5kbc/ont/>\nPREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n",
  "queries": [
    {
      "id": "classes-with-counts",
      "title": {
        "en": "Classes used, with counts",
        "de": "Verwendete Klassen mit Anzahl"
      },
      "intro": {
        "en": "What this collection actually contains. The counterpart to the void:classPartition statistics in the metadata: if the two disagree, the metadata is stale.",
        "de": "Was diese Sammlung tatsaechlich enthaelt — die Gegenprobe zur void:classPartition-Statistik in den Metadaten."
      },
      "sparql": "SELECT ?class (COUNT(?s) AS ?count) WHERE {\n  ?s a ?class\n} GROUP BY ?class ORDER BY DESC(?count)\n"
    },
    {
      "id": "sites",
      "title": {
        "en": "Sites with their labels",
        "de": "Fundstellen mit Bezeichnung"
      },
      "intro": {
        "en": "The archaeological sites themselves, the backbone of the dataset.",
        "de": "Die Fundstellen selbst, das Rueckgrat des Datensatzes."
      },
      "sparql": "SELECT ?site ?label WHERE {\n  ?site a bb5kbc:Fundstelle ;\n        rdfs:label ?label\n} ORDER BY ?label LIMIT 50\n"
    },
    {
      "id": "sites-via-crm",
      "title": {
        "en": "Sites via their CIDOC CRM superclass",
        "de": "Fundstellen ueber die CIDOC-CRM-Oberklasse"
      },
      "intro": {
        "en": "Checks that the alignment works: the query asks for crm:E27_Site and is answered from bb5kbc:Fundstelle. This is what makes the collection queryable alongside other N4O collections that never heard of this ontology.",
        "de": "Prueft, ob die Ausrichtung greift: gefragt wird nach crm:E27_Site, geantwortet wird aus bb5kbc:Fundstelle."
      },
      "sparql": "SELECT (COUNT(DISTINCT ?site) AS ?sites) WHERE {\n  ?site a/rdfs:subClassOf* crm:E27_Site\n}"
    }
  ]
}
