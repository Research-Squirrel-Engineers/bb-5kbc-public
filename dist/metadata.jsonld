  "title": {
    "en": "BB-5KBC: archaeological sites in Brandenburg, East Germany and West Poland around 5000 BC",
    "de": "BB-5KBC: Fundstellen in Brandenburg, Ostdeutschland und Westpolen um 5000 v. Chr."
  },
  "homepage": "https://doi.org/10.5281/zenodo.19830968",
